{
  "name": "@elayiastv/create-frontend-app",
  "version": "1.0.3",
  "description": "Starter Kit Angular institucional y generador de aplicaciones",
  "bin": {
    "create-frontend-app": "./tools/create-app.mjs"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ElayiasTV/plantilla_frontend.git"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --ssl",
    "start:http": "ng serve",
    "build": "ng build",
    "validate:env": "ts-node --project tsconfig.app.json tools/validate-env.ts",
    "build:local": "ng build --configuration development",
    "build:prod": "pnpm run validate:env && ng build --configuration production",
    "setup": "node ./tools/setup.mjs",
    "doctor": "node ./tools/doctor.mjs",
    "create-app": "node ./tools/create-app.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "security:audit": "pnpm audit --audit-level high",
    "ci": "pnpm run lint && pnpm run check:template-generation && pnpm run build && pnpm run test:ci",
    "lint": "pnpm run check:file-hygiene && pnpm run check:service-duplicates && pnpm run check:design-tokens && ng lint",
    "check:file-hygiene": "node ./tools/validate-no-backup-artifacts.mjs",
    "check:service-duplicates": "node ./tools/validate-service-duplications.mjs",
    "check:design-tokens": "node ./tools/validate-design-token-hardcodes.mjs",
    "check:template-generation": "node ./tools/validate-template-generation.mjs"
  },
  "private": false,
  "dependencies": {
    "@angular/animations": "^20.3.35",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.35",
    "@angular/compiler": "^20.3.35",
    "@angular/core": "^20.3.35",
    "@angular/forms": "^20.3.35",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.35",
    "@angular/platform-browser-dynamic": "^20.3.35",
    "@angular/router": "^20.3.35",
    "@angular/service-worker": "^20.3.35",
    "@fontsource/montserrat": "^5.3.0",
    "bootstrap-icons": "^1.13.2",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "material-design-icons": "^3.0.1",
    "material-icons": "^1.13.14",
    "material-symbols": "^0.44.12",
    "qrcode": "^1.5.4",
    "rxjs": "^7.8.2",
    "tslib": "^2.9.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.42",
    "@angular/cli": "^20.3.42",
    "@angular/compiler-cli": "^20.3.35",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@types/jasmine": "~5.1.15",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "8.46.4",
    "@typescript-eslint/parser": "8.46.4",
    "angular-eslint": "^20.7.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.46.4"
  },
  "engines": {
    "node": ">=18.13.0"
  }
}
